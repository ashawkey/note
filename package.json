{
  "name": "note",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A static notes site: Markdown rendered into Typora's DOM at build time, styled by the Su and Qi liquid-glass palettes.",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "npm run build:assets && npm run build:site && npm run build:search",
    "build:assets": "vite build",
    "build:site": "tsx scripts/build.ts",
    "build:search": "pagefind --site dist",
    "typecheck": "tsc --noEmit",
    "shoot": "npm run build && tsx scripts/shoot.ts",
    "serve": "tsx scripts/preview.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "pagefind": "^1.5.0",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "hast-util-to-html": "^9.0.4",
    "katex": "^0.16.19",
    "mdast-util-to-hast": "13.2.0",
    "refractor": "^5.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.6.1"
  }
}
